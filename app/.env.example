# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
# These are public client identifiers, safe to ship in the app bundle (not secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
# (auto-created by Firebase once you enable the Google provider)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to "true" only once you have a paid Apple Developer Program membership
# AND have enabled the "Sign In with Apple" capability on the com.raiz.app
# App ID. Until then, leave unset/false — the button stays hidden instead of
# appearing and failing when tapped. See app/README.md.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

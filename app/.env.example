# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration
# These are public client identifiers, safe to ship in the app bundle (not secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
# (auto-created by Firebase once you enable the Google provider)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to "true" only once you have a paid Apple Developer Program membership
# AND have enabled the "Sign In with Apple" capability on the com.raiz.app
# App ID. Until then, leave unset/false — the button stays hidden instead of
# appearing and failing when tapped. See app/README.md.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

# AdMob Console > Apps > (your app) > App settings > App ID.
# Leave unset during development — falls back to Google's official test App
# ID so ads still fill in dev builds without requesting real ads.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=

# AdMob Console > Apps > (your app) > Ad units > (each banner unit) > Ad unit ID.
# One pair per placement so each screen's fill/eCPM is reported separately.
# Leave unset during development — falls back to Google's test banner unit ID.
EXPO_PUBLIC_ADMOB_IOS_BANNER_PRODUCE_DETAIL=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_PRODUCE_DETAIL=
EXPO_PUBLIC_ADMOB_IOS_BANNER_HISTORY=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_HISTORY=
EXPO_PUBLIC_ADMOB_IOS_BANNER_SETTINGS=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_SETTINGS=
EXPO_PUBLIC_ADMOB_IOS_BANNER_REMOVE_ADS=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_REMOVE_ADS=
EXPO_PUBLIC_ADMOB_IOS_BANNER_RESIDUE=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_RESIDUE=

# Dev builds only (see initAds.ts) — forces the UMP consent SDK to treat
# this device as being in a specific region, so the consent form/"Ad Privacy
# Options" flow can be tested from anywhere, regardless of where you
# actually are. One of: EEA (GDPR), REGULATED_US_STATE (CCPA/CPRA and
# similar), OTHER. Defaults to REGULATED_US_STATE if unset. Each requires
# its own message to be created and published separately in the AdMob
# console under Privacy & messaging — they're independent flows, not one
# setting that covers both.
EXPO_PUBLIC_ADMOB_DEBUG_GEOGRAPHY=REGULATED_US_STATE

# Comma-separated, no spaces. To find your device's ID: run the app once,
# then check the console for a line like "To enable debug mode for this
# device, set: testDeviceIdentifiers = @[<value>]" — that <value> goes here.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
